<Application x:Class="Mosaic.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#233C3B"/>
  <SolidColorBrush x:Key="Muted" Color="#546864"/>
  <SolidColorBrush x:Key="Accent" Color="#286B5C"/>
  <SolidColorBrush x:Key="Line" Color="#D5DFD7"/>
  <SolidColorBrush x:Key="ControlLine" Color="#7D9184"/>

  <!-- Focus is an adorner, so it never moves the control or its label. -->
  <Style x:Key="FocusCue" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="10" Margin="-4"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#F7F8F4"/><Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="MenuItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style TargetType="Slider"><Setter Property="MinHeight" Value="32"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/></Style>

  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid>
      <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
      <Border x:Name="Feedback" Background="White" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Feedback" Property="Background" Value="#286B5C"/><Setter TargetName="Feedback" Property="Opacity" Value="0.07"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#174C40"/><Setter TargetName="Feedback" Property="Background" Value="#102F27"/><Setter TargetName="Feedback" Property="Opacity" Value="0.16"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Background" Value="#EDF0EB"/><Setter TargetName="Shell" Property="BorderBrush" Value="#CCD5CD"/><Setter Property="Foreground" Value="#617068"/><Setter TargetName="Feedback" Property="Opacity" Value="0"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- TextBox applies Padding to PART_ContentHost itself; the border must not apply it again. -->
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="17"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
      <ScrollViewer x:Name="PART_ContentHost"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#155643"/><Setter TargetName="Shell" Property="Background" Value="#FCFEFA"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Background" Value="#EDF0EB"/><Setter TargetName="Shell" Property="BorderBrush" Value="#CCD5CD"/><Setter Property="Foreground" Value="#617068"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
   <Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="Shell" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#E6EFE4"/><Setter Property="Foreground" Value="#204F43"/></Trigger>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Shell" Property="Background" Value="#D8E8DA"/><Setter Property="Foreground" Value="#173F34"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#617068"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <!-- Standard ComboBox retains selection, keyboard navigation, editable mode and UI Automation. -->
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource ControlLine}"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"/>
      <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" CornerRadius="8"><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{StaticResource Ink}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="Selection" Margin="10,8,36,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="0" MinHeight="0" FontSize="{TemplateBinding FontSize}" Margin="10,8,36,8" IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}">
       <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template>
      </TextBox>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
       <Border Background="White" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
        <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsEditable" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter Property="IsTabStop" Value="False"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#155643"/><Setter TargetName="Shell" Property="Background" Value="#FCFEFA"/></Trigger>
      <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Shell" Property="Background" Value="#F0F6ED"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Background" Value="#EDF0EB"/><Setter TargetName="Shell" Property="BorderBrush" Value="#CCD5CD"/><Setter Property="Foreground" Value="#617068"/><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.55"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>

  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,5,0,3"/><Setter Property="Padding" Value="4,5"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="MarkBox" Width="20" Height="20" CornerRadius="5" Background="White" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" VerticalAlignment="Center">
        <Path x:Name="Mark" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="1"/>
       </Border>
       <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MarkBox" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="MarkBox" Property="Background" Value="#EFF5EC"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="MarkBox" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="MarkBox" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="MarkBox" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Mark" Property="Data" Value="M 3,8 L 14,8"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="MarkBox" Property="BorderBrush" Value="#174C40"/><Setter TargetName="MarkBox" Property="Opacity" Value="0.78"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MarkBox" Property="Opacity" Value="0.55"/><Setter Property="Foreground" Value="#617068"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="4,5"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="MarkBox" Width="20" Height="20" CornerRadius="10" Background="White" BorderBrush="{StaticResource ControlLine}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Accent}" Visibility="Collapsed"/></Border>
      <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Grid></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MarkBox" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="MarkBox" Property="Background" Value="#EFF5EC"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="MarkBox" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="MarkBox" Property="Background" Value="#D8E8DA"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MarkBox" Property="Opacity" Value="0.55"/><Setter Property="Foreground" Value="#617068"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>

  <Style x:Key="DisclosureHeader" TargetType="ToggleButton">
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusCue}"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Shell" Background="#F5F8F2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,9">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource Accent}" StrokeThickness="1.8" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0,0 L 4,4 L 8,0"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#EAF2E6"/><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#DAE8D8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#617068"/><Setter TargetName="Shell" Property="Background" Value="#EDF0EB"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Margin" Value="0,14,0,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Expander">
     <StackPanel>
      <ToggleButton x:Name="HeaderSite" Style="{StaticResource DisclosureHeader}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" FontWeight="SemiBold" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
      <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </StackPanel>
     <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 </Application.Resources>
</Application>
